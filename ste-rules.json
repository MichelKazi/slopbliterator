{
  "standard": {
    "name": "ASD-STE100 Simplified Technical English",
    "issue": 9,
    "date": "2025-01-15",
    "source": "https://www.asd-ste100.org/assets/files/ASD-STE100_ISSUE9.pdf",
    "rule_count": 53,
    "notice": "Original paraphrases only. This file does not reproduce the standard or its controlled dictionary."
  },
  "automation_levels": {
    "enforced": "A deterministic check contributes to the score.",
    "advisory": "A conservative signal needs human judgment and does not change the score.",
    "manual": "The skill reviews this rule because a stdlib-only checker cannot decide it reliably."
  },
  "rules": [
    {"id":"1.1","section":"words","summary":"Use an approved general word or an accepted technical term.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.2","section":"words","summary":"Use an approved word only as its approved part of speech.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.3","section":"words","summary":"Use an approved word only with its approved meaning.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.4","section":"words","summary":"Use approved forms of verbs and adjectives.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.5","section":"words","summary":"Use technical nouns from an applicable category.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.6","section":"words","summary":"Use an unapproved word only inside an accepted technical noun.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.7","section":"words","summary":"Do not use a technical noun as a verb.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.8","section":"words","summary":"Use technical nouns accepted by the applicable organization or field.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.9","section":"words","summary":"Select technical nouns that are short and clear.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.10","section":"words","summary":"Keep regional language, slang, and jargon out of technical nouns.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.11","section":"words","summary":"Use one technical noun for each item.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.12","section":"words","summary":"Use technical verbs from an applicable category.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.13","section":"words","summary":"Do not use a technical verb as a noun.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"1.14","section":"words","summary":"Use American spelling unless an applicable directive says otherwise.","modes":["procedure","descriptive"],"automation":"advisory","coverage":"partial","detectors":["american_spelling(advisory)"]},
    {"id":"2.1","section":"multi-word nouns","summary":"Keep a multi-word noun to three words when possible.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"2.2","section":"multi-word nouns","summary":"Introduce a long technical noun in full before a clear short form.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"3.1","section":"verbs","summary":"Use an approved form of each verb.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"3.2","section":"verbs","summary":"Use simple approved verb forms and tenses.","modes":["procedure","descriptive"],"automation":"advisory","coverage":"partial","detectors":["complex_verb(advisory)"]},
    {"id":"3.3","section":"verbs","summary":"Use a past participle as an adjective only when that function is clear.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"3.4","section":"verbs","summary":"Do not build complex verbs from auxiliary verbs.","modes":["procedure","descriptive"],"automation":"advisory","coverage":"partial","detectors":["complex_verb(advisory)"]},
    {"id":"3.5","section":"verbs","summary":"Use an ing form only in an accepted technical noun.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["ing_main_verb"]},
    {"id":"3.6","section":"verbs","summary":"Use active voice unless a description has an unknown agent.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["passive_voice"]},
    {"id":"3.7","section":"verbs","summary":"Describe an action with a direct approved verb.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["nominalization"]},
    {"id":"4.1","section":"sentences","summary":"Write short, clear sentences.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["long_sentence(>20w)","long_sentence(>25w)"]},
    {"id":"4.2","section":"sentences","summary":"Do not omit necessary words or use contractions.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["contraction"]},
    {"id":"4.3","section":"sentences","summary":"Put complex information in a vertical list.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"4.4","section":"sentences","summary":"Connect sentences that discuss related topics.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"4.5","section":"sentences","summary":"Use an article or demonstrative before a noun when applicable.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"5.1","section":"procedures","summary":"Limit procedure sentences to 20 words.","modes":["procedure"],"automation":"enforced","coverage":"partial","detectors":["long_sentence(>20w)"]},
    {"id":"5.2","section":"procedures","summary":"Put one instruction in each sentence unless actions occur together.","modes":["procedure"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"5.3","section":"procedures","summary":"Write an instruction as a command.","modes":["procedure"],"automation":"advisory","coverage":"partial","detectors":["non_imperative_step(advisory)"]},
    {"id":"5.4","section":"procedures","summary":"Put a required condition before its command.","modes":["procedure"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"5.5","section":"procedures","summary":"Use a note for information, not for an instruction.","modes":["procedure"],"automation":"advisory","coverage":"partial","detectors":["instruction_in_note(advisory)"]},
    {"id":"6.1","section":"descriptions","summary":"Present descriptive information in a gradual order.","modes":["descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"6.2","section":"descriptions","summary":"Use key terms to show the logical structure.","modes":["descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"6.3","section":"descriptions","summary":"Limit descriptive sentences to 25 words.","modes":["descriptive"],"automation":"enforced","coverage":"partial","detectors":["long_sentence(>25w)"]},
    {"id":"6.4","section":"descriptions","summary":"Group related information in paragraphs.","modes":["descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"6.5","section":"descriptions","summary":"Keep one topic in each paragraph.","modes":["descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"6.6","section":"descriptions","summary":"Limit each paragraph to six sentences.","modes":["descriptive"],"automation":"enforced","coverage":"partial","detectors":["long_paragraph(>6s)"]},
    {"id":"7.1","section":"safety instructions","summary":"Identify the applicable risk level.","modes":["procedure"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"7.2","section":"safety instructions","summary":"Start a safety instruction with a clear command or condition.","modes":["procedure"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"7.3","section":"safety instructions","summary":"State the risk or possible result.","modes":["procedure"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"8.1","section":"punctuation and word count","summary":"Do not use semicolons.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"full","detectors":["semicolon"]},
    {"id":"8.2","section":"punctuation and word count","summary":"Use hyphens to connect words that form one unit.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"8.3","section":"punctuation and word count","summary":"Use parentheses only for a permitted technical purpose.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"8.4","section":"punctuation and word count","summary":"Treat a list-introducing colon as the end of a sentence.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["long_sentence(>20w)","long_sentence(>25w)"]},
    {"id":"8.5","section":"punctuation and word count","summary":"Count parenthetical text as one word.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["long_sentence(>20w)","long_sentence(>25w)"]},
    {"id":"8.6","section":"punctuation and word count","summary":"Count each specified technical element as one word.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["long_sentence(>20w)","long_sentence(>25w)"]},
    {"id":"8.7","section":"punctuation and word count","summary":"Count a hyphenated term as one word.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"full","detectors":["long_sentence(>20w)","long_sentence(>25w)"]},
    {"id":"9.1","section":"writing practices","summary":"Rewrite the sentence when a direct word replacement changes the meaning.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"9.2","section":"writing practices","summary":"Use each approved word correctly in its sentence.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]},
    {"id":"9.3","section":"writing practices","summary":"Do not combine words into an unapproved phrasal verb.","modes":["procedure","descriptive"],"automation":"enforced","coverage":"partial","detectors":["phrasal_verb"]},
    {"id":"9.4","section":"writing practices","summary":"Use terminology and wording consistently.","modes":["procedure","descriptive"],"automation":"manual","coverage":"manual","detectors":[]}
  ],
  "general_recommendations": [
    {"id":"GR-1","summary":"Review each use of that.","automation":"manual"},
    {"id":"GR-2","summary":"Review each use of with.","automation":"manual"},
    {"id":"GR-3","summary":"Keep pronoun references clear.","automation":"manual"},
    {"id":"GR-4","summary":"Give this a clear noun reference.","automation":"manual"},
    {"id":"GR-5","summary":"Check words that resemble words in another language.","automation":"manual"},
    {"id":"GR-6","summary":"Replace unclear Latin abbreviations.","automation":"manual"},
    {"id":"GR-7","summary":"Use inclusive language.","automation":"manual"},
    {"id":"GR-8","summary":"Keep possessive forms clear.","automation":"manual"}
  ]
}
